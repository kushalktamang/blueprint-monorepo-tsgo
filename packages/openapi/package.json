{
  "name": "@blueprint/openapi",
  "version": "1.0.0",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen": "tsx src/gen.ts",
    "build": "tsc",
    "dev": "wait-on ../zod/dist/index.js && tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "clean": "node src/scripts/clean.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@blueprint/zod": "workspace:*",
    "@ts-rest/core": "catalog:",
    "@ts-rest/open-api": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "catalog:",
    "tsx": "catalog:",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "wait-on": "catalog:"
  }
}
